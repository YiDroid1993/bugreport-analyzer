<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.yidroid.buganalyzer.plugin.ui.SearchResultDialog">
  <grid id="cbd77" binding="contentPane" layout-manager="BorderLayout" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="1000" height="700"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
       <grid id="layeredContainer" binding="layeredContainer" layout-manager="BorderLayout" hgap="0" vgap="0">
         <margin top="0" left="0" bottom="0" right="0"/>
         <constraints border-constraint="Center"/>
         <properties/>
         <border type="none"/>
         <children/>
       </grid>
       <component id="statusLabel" class="javax.swing.JLabel" binding="statusLabel">
          <constraints border-constraint="South"/>
          <properties>
             <text value="Searching..."/>
          </properties>
       </component>
    </children>
  </grid>
</form>
