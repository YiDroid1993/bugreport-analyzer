<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.buganalyzer.plugin.ui.ProjectPanel">
  <grid id="27dc6" binding="contentPane" layout-manager="BorderLayout" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="800" height="600"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="topBar" layout-manager="BorderLayout" hgap="0" vgap="0">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="backButton" class="javax.swing.JButton" binding="backButton">
            <constraints border-constraint="West"/>
            <properties>
              <text value="Back"/>
            </properties>
          </component>
          <component id="projectLabel" class="javax.swing.JLabel" binding="projectLabel">
            <constraints border-constraint="Center"/>
            <properties>
              <horizontalAlignment value="0"/>
              <text value="Project Name"/>
            </properties>
          </component>
        </children>
      </grid>
      <splitpane id="mainSplit">
        <constraints border-constraint="Center"/>
        <properties>
          <dividerLocation value="300"/>
        </properties>
        <border type="none"/>
        <children>
          <splitpane id="sidebarSplit">
            <constraints>
              <splitpane position="left"/>
            </constraints>
            <properties>
              <orientation value="0"/>
              <dividerLocation value="300"/>
            </properties>
            <border type="none"/>
            <children>
              <grid id="filePanel" layout-manager="BorderLayout" hgap="0" vgap="0">
                 <margin top="0" left="0" bottom="0" right="0"/>
                 <constraints>
                   <splitpane position="left"/>
                 </constraints>
                 <properties/>
                 <border type="none"/>
                 <children>
                   <component id="filesLabel" class="javax.swing.JLabel">
                     <constraints border-constraint="North"/>
                     <properties><text value="Files"/></properties>
                   </component>
                   <scrollpane id="filesScroll">
                     <constraints border-constraint="Center"/>
                     <properties/>
                     <border type="none"/>
                     <children>
                       <component id="fileList" class="com.intellij.ui.components.JBList" binding="fileList">
                         <properties/>
                       </component>
                     </children>
                   </scrollpane>
                 </children>
              </grid>
              <grid id="partsPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
                 <margin top="0" left="0" bottom="0" right="0"/>
                 <constraints>
                   <splitpane position="right"/>
                 </constraints>
                 <properties/>
                 <border type="none"/>
                 <children>
                   <component id="partsLabel" class="javax.swing.JLabel">
                     <constraints border-constraint="North"/>
                     <properties><text value="Parts"/></properties>
                   </component>
                   <scrollpane id="partsScroll">
                     <constraints border-constraint="Center"/>
                     <properties/>
                     <border type="none"/>
                     <children>
                       <component id="partsList" class="com.intellij.ui.components.JBList" binding="partsList">
                         <properties/>
                       </component>
                     </children>
                   </scrollpane>
                 </children>
              </grid>
            </children>
          </splitpane>
          <grid id="textPanelContainer" binding="textPanelContainer" layout-manager="BorderLayout" hgap="0" vgap="0">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <splitpane position="right"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
        </children>
      </splitpane>
    </children>
  </grid>
</form>
